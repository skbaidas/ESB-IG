# Python bytecode
__pycache__/
*.py[cod]
*.egg-info/

# Virtual environments — never committed; requirements are the reproducible
# artefact, not the installed tree.
.venv/
venv/
env/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# Local environment. Connection parameters are supplied by the deployment and
# have no code-side default; a committed .env is how that rule gets quietly
# reversed.
.env
*.env

# OS
Thumbs.db
.DS_Store

# Wire-only gate artefacts. `.github/workflows/ci.yml` writes these at the repo
# root and uploads them with the run; each describes ONE execution on ONE
# machine, so a committed copy would carry that machine's provenance. The
# artefact that IS committed is `evidence/gate-catalogue.json`, which the
# catalogue gate writes into the tree on purpose — it is the adoption's evidence.
/gate-boundary.json
/gate-broker.json
/gate-tests.json
/test-suite.txt
/dev-requirements.txt

# Build outputs. `pip install .` and `python -m build` leave these behind; the
# wheel is produced from the tree on demand and a committed copy would be a
# second rendering of the source.
/build/
/dist/
